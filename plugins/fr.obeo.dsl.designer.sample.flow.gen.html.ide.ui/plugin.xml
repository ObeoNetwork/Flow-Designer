<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="fr.obeo.dsl.designer.sample.flow.gen.html.ide.ui.handlers.GenerateHTMLGeneratorHandler"
            commandId="fr.obeo.dsl.designer.sample.flow.gen.html.ide.ui.commands.generateHTMLGeneratorCommand">
      </handler>
   </extension>
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <menu
               id="fr.obeo.dsl.designer.sample.flow.gen.ide.ui.menus.generators"
               label="Generators">
            <command
                  commandId="fr.obeo.dsl.designer.sample.flow.gen.html.ide.ui.commands.generateHTMLGeneratorCommand"
                  icon="icons/html_tag_obj.gif"
                  id="fr.obeo.dsl.designer.sample.flow.gen.html.ide.ui.menus.generateHTMLGeneratorCommandOnEObject"
                  label="Generate HTML">
               <visibleWhen
                     checkEnabled="false">
                  <with
                        variable="selection">
                     <iterate
                           ifEmpty="false"
                           operator="and">
                        <instanceof
                              value="fr.obeo.dsl.designer.sample.flow.System">
                        </instanceof>
                     </iterate>
                  </with>
               </visibleWhen>
            </command>
            <command
                  commandId="fr.obeo.dsl.designer.sample.flow.gen.html.ide.ui.commands.generateHTMLGeneratorCommand"
                  icon="icons/html_tag_obj.gif"
                  id="fr.obeo.dsl.designer.sample.flow.gen.html.ide.ui.menus.generateHTMLGeneratorCommandOnIFile"
                  label="Generate HTML">
               <visibleWhen
                     checkEnabled="false">
                  <with
                        variable="selection">
                     <iterate
                           ifEmpty="false"
                           operator="and">
                        <and>
                           <instanceof
                                 value="org.eclipse.core.resources.IFile">
                           </instanceof>
                           <test
                                 property="org.eclipse.core.resources.extension"
                                 value="flow">
                           </test>
                        </and>
                     </iterate>
                  </with>
               </visibleWhen>
            </command>
         </menu>
      </menuContribution>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
      <category
            id="fr.obeo.dsl.designer.sample.flow.gen.ide.ui.commands.generatorsCategory"
            name="Generators">
      </category>
      <command
            categoryId="fr.obeo.dsl.designer.sample.flow.gen.ide.ui.commands.generatorsCategory"
            id="fr.obeo.dsl.designer.sample.flow.gen.html.ide.ui.commands.generateHTMLGeneratorCommand"
            name="Generate HTML">
      </command>
   </extension>

</plugin>
