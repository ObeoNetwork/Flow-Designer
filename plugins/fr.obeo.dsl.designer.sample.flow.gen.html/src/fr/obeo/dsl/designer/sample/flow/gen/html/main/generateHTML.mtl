[module generateHTML('http://www.obeo.fr/dsl/designer/sample/flow')/]

[comment encoding = UTF-8 /]
[comment @main/]
[template public generateHTML(aSystem : flow::System) ? (self.eContainer() = null)]
  [file (aSystem.name.concat('.html'), overwrite, 'UTF-8')]
    <html>
    <link href="Flow.css" type="text/css" rel="stylesheet" media="all" />
    <h1>System: [aSystem.name/]</h1>
    <table>
    [aSystem.poweredProperties()/]
    [aSystem.flowElementPropeties()/]
    [aSystem.systemProperties()/]
    </table>
    <p></p>
    [if (aSystem.elements->size() > 0)]
      <table>
      <tr>
      <th>Components</th><th>Type</th>
      </tr>
      [for (element : flow::Named | aSystem.elements->filter(flow::Named))]
        <tr>
        <td><a href="#[element.name/]">[element.name/]</a></td><td>[element.eClass().name/]</td>
        </tr>
      [/for]
      </table>
    [/if]
    
    [for (element : flow::FlowElement | aSystem.elements)]
      [element.generateFlowElement()/]
    [/for]
    
  [/file]
  
  [file ('flow.css', overwrite, 'UTF-8')]
    [aSystem.cssBody()/]
  [/file]
  
[/template]

[template public generateFlowElement(element : flow::FlowElement)]
[/template]

[template public generateFlowElement(element : flow::CompositeProcessor)]
  <hr>
  <h2><a name="[element.name/]"></a>[element.eClass().name/]: [element.name/]<h2>
  <table>
  [element.poweredProperties()/]
  [element.flowElementPropeties()/]
  [element.systemProperties()/]
  [element.capacityBoundProperties()/]
  </table>
  <p></p>
  [if (element.elements->size() > 0)]
    <table>
    <tr>
    <th>Components</th><th>Type</th>
    </tr>
    [for (element : flow::Named | element.elements->filter(flow::Named))]
      <tr>
      <td><a href="#[element.name/]">[element.name/]</a></td><td>[element.eClass().name/]</td>
      </tr>
    [/for]
    </table>
  [/if]
  [for (element : flow::FlowElement | element.elements)]
    [element.generateFlowElement()/]
  [/for]
[/template]

[template public generateFlowElement(element : flow::Processor)]
  <hr>
  <h2><a name="[element.name/]"></a>[element.eClass().name/]: [element.name/]<h2>
  <table>
  [element.poweredProperties()/]
  [element.flowElementPropeties()/]
  <tr>
  <td class="property">Volume</td><td>[element.volume/]</td>
  </tr>
  <tr>
  <td class="property">Weight</td><td>[element.weight/]</td>
  </tr>
  [element.capacityBoundProperties()/]
  <tr>
  </table>
  <p></p>
  [if (element.outgoingFlows->size() > 0)]
    <table>
    <tr>
    <th>Flows to</th><th class="value">Load</th><th class="value">Capacity</th>
    </tr>
    [for (flow : flow::DataFlow | element.outgoingFlows)]
      <tr>
      <td><a href="#[flow.target.oclAsType(flow::Named).name/]">[flow.target.oclAsType(flow::Named).name/]</a></td><td>[flow.load/]</td><td>[flow.capacity/]</td>
      </tr>
    [/for]
    </table>
  [/if]
[/template]

[template public generateFlowElement(element : flow::DataSource)]
  <hr>
  <h3><a name="[element.name/]"></a>[element.eClass().name/]: [element.name/]<h3>
  <table>
  [element.flowElementPropeties()/]
  <tr>
  <td class="property">Volume</td>
  <td>[element.volume/]</td>
  </tr>
  <tr>
  </table>
  <p></p>
  [if (element.outgoingFlows->size() > 0)]
    <table>
    <tr>
    <th>Flows to</th><th class="value">Load</th><th class="value">Capacity</th>
    </tr>
    [for (flow : flow::DataFlow | element.outgoingFlows)]
      <tr>
      <td><a href="#[flow.target.oclAsType(flow::Named).name/]">[flow.target.oclAsType(flow::Named).name/]</a></td><td>[flow.load/]</td><td>[flow.capacity/]</td>
      </tr>
    [/for]
    </table>
  [/if]
  
[/template]

[template public poweredProperties(element : flow::Powered)]
  <tr>
  <td class="property">Consumption</td><td class="value">[element.consumption/]</td>
  </tr>
  <tr>
  <td class="property">Power Status</td><td>[element.powerStatus/]</td>
  </tr>[/template]

[template public flowElementPropeties(aFlowElement : flow::FlowElement)]
  <tr>
  <td class="property">Status</td><td>[aFlowElement.status/]</td>
  </tr>
  <tr>
  <td class="property">Usage</td><td>[aFlowElement.usage/]</td>
  </tr>
  <tr>[/template]

[template public capacityBoundProperties(element : flow::CapacityBound)]
  <tr>
  <td class="property">Capacity</td><td>[element.capacity/]</td>
  </tr>
  <tr>
  <td class="property">Load</td><td>[element.load/]</td>
  </tr>[/template]

[template public systemProperties(aSystem : flow::System)]
  <tr>
  <td class="property">Temperature</td><td>[aSystem.temperature/]</td>
  </tr>
  <tr>
  <td class="property">Weight</td><td>[aSystem.weight/]</td>
  </tr>[/template]

[template public cssBody(obj : flow::System)]
  table,p, h1,h2,h3
  {
      font-family: sans-serif;
      color: #007788;
  }
  
  table
  {
      border-collapse: collapse;
  }
  th,td 
  {
     padding: 10px;
  }
  td
  {
      border: 1px solid black;
  }
  td.property
  {
      border: 1px solid black;
      background-color: #007788;
      color: white;
      font-weight:bold;
      width: 200;
  }
  td.value
  {
      border: 1px solid black;
      width: 100;
  }
  th
  {
      text-align: left;
      border: 1px solid black;
      width: 200;
      background-color: #fbb800;
      color: white;
  }
  th.value
  {
      text-align: left;
      border: 1px solid black;
      width: 50;
      background-color: #fbb800;
      color: white;
  }[/template]