[module generateJava('http://www.obeo.fr/dsl/designer/sample/flow')/]

[comment encoding = UTF-8 /]
[comment Generate a class for each Composite /]
[comment @main/]
[template public generateJava(aCompositeProcessor : flow::CompositeProcessor)]
  [file (aCompositeProcessor.name.toLower() + '/' + aCompositeProcessor.name.concat('Composite.java'), overwrite, 'UTF-8')]
    
    package [aCompositeProcessor.name.toLower()/];
    
    [for (element : flow::Processor | aCompositeProcessor.elements->filter(flow::Processor))]
      import [element.eContainer(flow::System).name.toLower()/].[element.name/];
    [/for]
    
    public class [aCompositeProcessor.name/]Composite {
    	
    	final int CONSUMPTION=[aCompositeProcessor.consumption/];
    	final int TEMPERATURE=[aCompositeProcessor.temperature/];
    	final int WEIGHT=[aCompositeProcessor.weight/];
    	final int CAPACITY=[aCompositeProcessor.capacity/];
    	final int LOAD=[aCompositeProcessor.load/];
    	
    [for (element : flow::Processor | aCompositeProcessor.elements->filter(flow::Processor))]
      	public [element.name/] get[element.name/]() {
      		[protected ('to obtain processor descriptor of ' + element.name + ' from Hardware specific API') startTagPrefix('// ') endTagPrefix('// ')]
      		  return null; // TODO to implement 		
      		[/protected]
      	}
    [/for]
    
    	public boolean isTemperatureConforms() {
    		int totalRealTemperature = 0;
    [for (proc : flow::Processor | aCompositeProcessor.elements->filter(flow::Processor))]
      		totalRealTemperature+= get[proc.name/]().getRealTemperature();
    [/for]
    		if (totalRealTemperature <= TEMPERATURE)
    			return true;
    		else
    			return false;
    	}
    
    }[/file]
[/template]

[comment @main/]
[template public generateJava(aCompositeProcessor : flow::Processor)]
  [file (aCompositeProcessor.eContainer(flow::System).name.toLower() + '/' + aCompositeProcessor.name.concat('.java'), overwrite, 'UTF-8')]
    
    package [aCompositeProcessor.eContainer(flow::System).name.toLower()/];
    
    public interface [aCompositeProcessor.name/] {
    	
    	final int CONSUMPTION=[aCompositeProcessor.consumption/];
    	final int VOLUME=[aCompositeProcessor.volume/];
    	final int WEIGHT=[aCompositeProcessor.weight/];
    	final int CAPACITY=[aCompositeProcessor.capacity/];
    	final int LOAD=[aCompositeProcessor.load/];
    
    	public int getRealTemperature();
    }[/file]
[/template]